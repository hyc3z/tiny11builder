<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <LinearGradientBrush x:Key="CandyCanvas" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF5F8" Offset="0"/><GradientStop Color="#F5FFFB" Offset="0.55"/><GradientStop Color="#FFFCEB" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CandySidebar" Color="#FFF8FB"/>
            <SolidColorBrush x:Key="CandyPane" Color="#FAFFFD"/>
            <SolidColorBrush x:Key="CandyPink" Color="#B92768"/>
            <SolidColorBrush x:Key="CandyPinkSoft" Color="#FFE7F1"/>
            <SolidColorBrush x:Key="CandyMint" Color="#E0F9EF"/>
            <SolidColorBrush x:Key="CandyLemon" Color="#FFF4C7"/>
            <SolidColorBrush x:Key="CandyLavender" Color="#EEE8FF"/>
            <SolidColorBrush x:Key="CandyInk" Color="#352B49"/>
            <SolidColorBrush x:Key="CandyMuted" Color="#6A607A"/>
            <SolidColorBrush x:Key="CandyStroke" Color="#EEDCE8"/>
            <LinearGradientBrush x:Key="CandyHero" StartPoint="0,0" EndPoint="1,0.7">
                <GradientStop Color="#FFE5F0" Offset="0"/><GradientStop Color="#F0E8FF" Offset="0.5"/><GradientStop Color="#DDFAEE" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#352B49"/>
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#6A607A"/>
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#776C86"/>
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#EEDCE8"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#B92768"/>
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#9D2056"/>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#CB326F"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#B92768"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#A52158"/>
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#F1D3E0"/>
            <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#B92768"/>
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#CB326F"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#B92768"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#A52158"/>
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ButtonBackground" Color="#FFF0F6"/>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFE1EE"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#F6D1E3"/>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#EAC8DA"/>
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#DDA5C1"/>
            <SolidColorBrush x:Key="ButtonForeground" Color="#71344F"/>
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#71344F"/>
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#71344F"/>
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#FFE7F1"/>
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#F6D1E3"/>
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFF6FA"/>
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#DEC9D9"/>
            <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#8D7088"/>
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FAFFFD"/>
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FFF8FB"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FFE7F1"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FFD9E9"/>
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#E0F9EF"/>
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#CB326F"/>
            <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#71344F"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="CandyCanvas" Color="#251D32"/>
            <SolidColorBrush x:Key="CandySidebar" Color="#30243E"/>
            <SolidColorBrush x:Key="CandyPane" Color="#2B2339"/>
            <SolidColorBrush x:Key="CandyPink" Color="#FFB3D5"/>
            <SolidColorBrush x:Key="CandyPinkSoft" Color="#50324A"/>
            <SolidColorBrush x:Key="CandyMint" Color="#254A43"/>
            <SolidColorBrush x:Key="CandyLemon" Color="#51452C"/>
            <SolidColorBrush x:Key="CandyLavender" Color="#423553"/>
            <SolidColorBrush x:Key="CandyInk" Color="#FFF2FA"/>
            <SolidColorBrush x:Key="CandyMuted" Color="#D8C6E0"/>
            <SolidColorBrush x:Key="CandyStroke" Color="#665273"/>
            <SolidColorBrush x:Key="CandyHero" Color="#423553"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="CandyCanvas" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="CandySidebar" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="CandyPane" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="CandyPink" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="CandyPinkSoft" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="CandyMint" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="CandyLemon" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="CandyLavender" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="CandyInk" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="CandyMuted" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="CandyStroke" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="CandyHero" Color="{ThemeResource SystemColorWindowColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="CheckBoxCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="ListViewItemCornerRadius">14</CornerRadius>
</ResourceDictionary>
